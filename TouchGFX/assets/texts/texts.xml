<?xml version="1.0" encoding="utf-8"?>
<TextDatabase xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="texts.xsd" Version="4.26.1">
  <Languages>
    <Language Id="GB" />
  </Languages>
  <Texts>
    <TextGroup Id="Group1">
      <Text Id="WcDefaultLeft" Alignment="Left" TypographyId="Default">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcDefaultCenter" Alignment="Center" TypographyId="Default">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcDefaultRight" Alignment="Right" TypographyId="Default">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcLargeCenter" Alignment="Center" TypographyId="Large">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcSmallLeft" Alignment="Left" TypographyId="Small">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcSmallCenter" Alignment="Center" TypographyId="Small">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcSmallRight" Alignment="Right" TypographyId="Small">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcMediumLeft" Alignment="Left" TypographyId="Medium">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcMediumCenter" Alignment="Center" TypographyId="Medium">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="WcMediumRight" Alignment="Right" TypographyId="Medium">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
    </TextGroup>
  </Texts>
  <!--
    TEXT SIZE = the "Size" attribute below. Change it and regenerate to resize
    all text of that role (delete generated/texts and generated/fonts first).
      Large   (40) : big metric values (BPM / SpO2 / SQI)
      Default (20) : titles, badges, primary labels, buttons
      Medium  (14) : data rows (InfoRow), settings, dense text
      Small   (10) : captions, status bar, secondary info
    Widget POSITIONS/SIZES live in gui/common/GuiLayout.hpp, not here.
  -->
  <Typographies>
    <Typography Id="Default" Font="verdana.ttf" Size="20" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacterRanges="0x20-0x7E" />
    <Typography Id="Large" Font="verdana.ttf" Size="40" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacterRanges="0x20-0x7E" />
    <Typography Id="Small" Font="verdana.ttf" Size="10" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacterRanges="0x20-0x7E" />
    <Typography Id="Medium" Font="verdana.ttf" Size="14" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacterRanges="0x20-0x7E" />
  </Typographies>
</TextDatabase>
